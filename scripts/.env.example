# Copy this file to .env and fill in your real values.
# Never commit .env (or a filled-in .env.example) to version control.

GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_platform_api_key_here
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
VERCEL_BASE_URL=https://your-demo-site.vercel.app
SENDER_NAME=Your Agency Name
NOTIFY_EMAIL=
API_SECRET_KEY=

# ── CAN-SPAM compliance (REQUIRED before sending real commercial email) ──
# US law requires a valid physical mailing address in every commercial email.
SENDER_PHYSICAL_ADDRESS=123 Main St, Suite 100, Springfield, IL 62704
# Your API's own public URL — the unsubscribe link in every email points here.
API_PUBLIC_BASE_URL=https://leadgen-engine-ngxx.onrender.com
